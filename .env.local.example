# Sanity CMS
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id_here
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=your_api_token_here

# ISR Revalidation webhook secret (make up any random string)
SANITY_REVALIDATE_SECRET=your_random_secret_here

# Draft preview (WP4 6.6)
# Random string; the owner types it once in the preview form (browser can save it)
SANITY_PREVIEW_SECRET=
# Sanity Viewer token (sanity.io/manage -> API -> Tokens -> Viewer)
SANITY_API_READ_TOKEN=
